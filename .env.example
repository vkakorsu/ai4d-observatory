# Copy to .env and adjust. Every variable has a working default for local use.

# Secret used to sign sessions and gated-download tokens. Generate with `openssl rand -hex 32`.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Database. SQLite for local development and the evaluation prototype.
# For PostgreSQL in production use e.g. postgres://user:password@host:5432/ai4d
DATABASE_URI=file:./data/ai4d.db

# Public URL of the site, used for absolute links, sitemaps and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Media storage. "local" writes to ./media. "vercel-blob" uses Vercel Blob (needs BLOB_READ_WRITE_TOKEN).
MEDIA_STORAGE=local
BLOB_READ_WRITE_TOKEN=

# Newsletter provider. "local" stores subscribers in the CMS only.
# "brevo" requires BREVO_API_KEY and BREVO_LIST_ID. "mailchimp" requires MAILCHIMP_API_KEY, MAILCHIMP_SERVER_PREFIX, MAILCHIMP_LIST_ID.
# Accounts must be in the Client's name. See DEPLOY.md.
NEWSLETTER_PROVIDER=local
BREVO_API_KEY=
BREVO_LIST_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_LIST_ID=

# Analytics provider. "none", "umami" (needs NEXT_PUBLIC_UMAMI_SCRIPT_URL and NEXT_PUBLIC_UMAMI_WEBSITE_ID) or "ga4" (needs NEXT_PUBLIC_GA4_ID).
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_GA4_ID=

# Gated download link lifetime in minutes.
GATE_TOKEN_TTL_MINUTES=30

# Set to "true" on evaluation and staging hosts so search engines never index them.
NEXT_PUBLIC_NOINDEX=false

# Jobs runner for scheduled publishing. Runs every minute on a server; automatically off on Vercel.
# Set to "false" to disable. On serverless hosts call GET /api/payload-jobs/run from a cron with
# "Authorization: Bearer <CRON_SECRET>".
JOBS_AUTORUN=true
CRON_SECRET=

# Docker Compose only (docker-compose.yml). Ignored by `pnpm dev`.
SITE_DOMAIN=observatory.example.org
ACME_EMAIL=webmaster@example.org
POSTGRES_USER=ai4d
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai4d

# Seed script. Demo users created by `pnpm seed`. Change before any public deployment.
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=ObservatoryAdmin2026!
SEED_EDITOR_EMAIL=editor@example.org
SEED_EDITOR_PASSWORD=ObservatoryEditor2026!
